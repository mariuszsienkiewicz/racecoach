# Copy to `.env` for local Symfony outside Compose, or as a reference for overrides.
# Docker Compose already injects these values - see docker-compose.yml.
#
# DO NOT put production secrets here.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_racecoach_dev_secret_32chars
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://racecoach:racecoach@database:5432/racecoach?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=amqp://racecoach:racecoach@rabbitmq:5672/%2f/messages
###< symfony/messenger ###

###> racecoach/minio ###
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=racecoach
S3_SECRET_KEY=racecoachsecret
S3_BUCKET=racecoach-fits
S3_USE_PATH_STYLE=true
###< racecoach/minio ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=racecoach_dev_jwt
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> racecoach/workers ###
# Go workers → Symfony (header X-Worker-Token). Not a user JWT.
WORKER_API_TOKEN=dev-worker-token-change-me
# Symfony → fit-chat (Authorization: Bearer). Separate from worker token.
CHAT_SERVICE_TOKEN=dev-chat-service-token-change-me
CHAT_SERVICE_BASE_URL=http://fit-chat:8081
###< racecoach/workers ###
