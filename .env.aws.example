# cp .env.aws.example .env.aws

# Public hostname
DOMAIN=racecoach.heaps.pl
CORS_ALLOW_ORIGIN=^https://racecoach\.heaps\.pl$

# RDS
POSTGRES_HOST=YOUR_RDS_HOSTNAME.eu-north-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=YOUR_DB_USER
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_RDS_HOSTNAME.eu-north-1.rds.amazonaws.com:5432/racecoach?serverVersion=16&charset=utf8

# S3
S3_ENDPOINT=https://s3.eu-north-1.amazonaws.com
S3_REGION=eu-north-1
S3_BUCKET=YOUR_BUCKET
S3_ACCESS_KEY=YOUR_ACCESS_KEY_ID
S3_SECRET_KEY=YOUR_SECRET_ACCESS_KEY
S3_USE_PATH_STYLE=false

# LLM (OpenAI-compatible). Local: Ollama. AWS demo, OpenRouter.
# Docs: docs/aws-deploy-ec2.md - section "LLM on AWS (OpenRouter)"
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
LLM_API_KEY=YOUR_OPENROUTER_API_KEY
